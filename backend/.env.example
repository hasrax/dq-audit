# Copy this file to backend/.env and fill in real values. backend/.env is
# gitignored and must never be committed.

# --- LLM (one OpenAI-compatible endpoint; provider is config, not code) ---
# Groq (cloud, free tier) shown. Swap freely:
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1  (key can be blank)
#   OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-api-key-here

# --- PostgreSQL issue repository ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dq_audit
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# --- Optional: LLM options an admin can switch between in the dashboard ---
# name | base_url | model | NAME of the env var holding the key (blank = none)
# LLM_OPTIONS=Groq Llama 3.3 70B|https://api.groq.com/openai/v1|llama-3.3-70b-versatile|LLM_API_KEY;Ollama Qwen 2.5 7B (local)|http://localhost:11434/v1|qwen2.5:7b|
