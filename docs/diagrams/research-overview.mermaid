graph TB
    subgraph GAP["1 · RESEARCH GAP — DSR Awareness"]
        G1["Existing DQ tools: expensive,<br/>technical, need DB access,<br/>no plain-language explanations"]
        G2["Sri Lankan SME ERPs: poor data quality<br/>from manual entry & bulk imports<br/>(Senadheera 2018 · Opatha 2024)"]
        G3["Cross-table errors (Invoice vs GRN)<br/>invisible to single-file CSV checks"]
        G1 --> G4["GAP: no explainable, low-cost, automated,<br/>cross-table DQ AUDIT framework<br/>for SME ERP CSV exports"]
        G2 --> G4
        G3 --> G4
    end

    RQ["RQ: How can a hybrid rule-based profiling engine<br/>with LLM-based explanation provide scalable,<br/>explainable DQ audit for SeefaERP SME systems?"]

    subgraph DATA["2 · REAL DATA — ~1.2M rows"]
        subgraph PRIMARY["PRIMARY — same ERP, two clients"]
            DB1["Hemas (SeefaERP)<br/>StockHistory 482K · InvoiceDetails 272K<br/>AccountTransaction 213K · GRNDtl 20.6K"]
            DB2["Ussawatte (SeefaERP)<br/>Dis_InvoiceDetails 141K · CustomerMaster 43.7K<br/>Dis_InvoiceHeader 42.4K · WhyNotBilling 45.6K"]
        end
        DB3["St. Anthony — bakery/manufacturing<br/>InvoiceDetails 283K · DailyStockOutlets 293K<br/>TRANSFERABILITY PROBE ONLY (future work)"]
    end

    subgraph SOL["3 · SOLUTION — Five-Layer Explainable DQ Audit System (DSR artifact)"]
        S0["L0 · Ingestion & Profiling<br/>types · stats · PK/FK discovery · sampling"]
        S1["L1 · Rules Engine — Type 1, all rows<br/>6 auto-derived checks, deterministic"]
        S2["L2 · LLM Auditor — Type 2, selective<br/>Ollama local · explains · recommends · fixability"]
        S3["L3 · Human Triage<br/>flagged → accepted / rejected / considered"]
        S4["L4 · Monitoring<br/>severity-weighted DQ score · trends"]
        S0 --> S1 --> S2 --> S3 --> S4
    end

    subgraph NOV["4 · NOVELTY & CONTRIBUTIONS"]
        N1["First LLM-based DQ audit framework<br/>for Sri Lankan SME ERPs"]
        N2["3-state HITL workflow whose output<br/>IS the ground truth (evaluation-in-use)"]
        N3["Two-error-type taxonomy with<br/>MEASURED complementarity"]
        N4["Formal issue ontology —<br/>transferable conceptual artifact"]
        N5["Fixable / non-fixable classification<br/>for SME prioritization"]
    end

    subgraph EVAL["5 · EVALUATION — DSR Cycle 4"]
        V1["E1 · Synthetic Error Injection<br/>seeded, versioned · P/R/F1 per detector<br/>rules ≥0.90 recall Type 1 · combined ≥0.90"]
        V2["E2 · Complementarity Analysis<br/>% caught only-rules / only-LLM / both"]
        V3["E3 · Triage-Derived Metrics<br/>precision = acc/(acc+rej) ≥0.80<br/>hallucination rate = rejected LLM issues"]
        V4["E4 · Cross-Client Reproducibility<br/>Hemas vs Ussawatte · ≥80% rules apply to both"]
        V5["E5 · Transferability Probe<br/>St. Anthony · descriptive only"]
        V6["E6 · SUS Usability<br/>5–8 SME users · target > 80"]
    end

    G4 ==> RQ ==> SOL
    DB1 & DB2 ==> SOL
    DB3 -.-> V5
    SOL -.-> N1 & N2 & N3 & N4 & N5
    SOL ==> V1 & V2 & V3 & V4 & V6

    CLAIM["CLAIMS DISCIPLINE:<br/>reproducibility across clients of one ERP ✔<br/>preliminary transferability ✔<br/>generalizability ✘ (future work)"]
    V4 --> CLAIM
    V5 --> CLAIM
