# Copy into Streamlit Community Cloud -> app -> Settings -> Secrets.
# NEVER commit a real secrets.toml (it is git-ignored). Root-level keys
# become environment variables, which is how the app reads them.

DATABASE_URL = "postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-120b"
LLM_API_KEY = "gsk_..."

# Optional: models an admin can switch to in Settings (thesis numbers use Groq only)
OPENROUTER_API_KEY = "sk-or-..."
LLM_OPTIONS = "Groq GPT-OSS 120B|https://api.groq.com/openai/v1|openai/gpt-oss-120b|LLM_API_KEY;OpenRouter DeepSeek V3.2|https://openrouter.ai/api/v1|deepseek/deepseek-v3.2|OPENROUTER_API_KEY"
# Chat-only backup (free models, tried in order) when the main model fails after its retries; never used for audits
LLM_CHAT_FALLBACK = "OpenRouter Gemma 4 31B (free)|https://openrouter.ai/api/v1|google/gemma-4-31b-it:free|OPENROUTER_API_KEY;OpenRouter Gemma 4 26B (free)|https://openrouter.ai/api/v1|google/gemma-4-26b-a4b-it:free|OPENROUTER_API_KEY;OpenRouter Nemotron 3 Ultra (free)|https://openrouter.ai/api/v1|nvidia/nemotron-3-ultra-550b-a55b:free|OPENROUTER_API_KEY"

# Google Form pre-filled link with P00 in the participant-code field
SUS_FORM_PREFILL_URL = "https://docs.google.com/forms/d/e/.../viewform?usp=pp_url&entry.XXXX=P00"
